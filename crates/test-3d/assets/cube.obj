# Unit cube centred at the origin, per-face normals + UVs.
# Vertex order + winding match the hand-rolled cube in `crates/test-3d/src/scene.rs`
# (CW from outside, since the engine's pipelines use FrontFace::CLOCKWISE).
# Loaded by `Resources::load_obj` when test-3d is built with `--features obj`.

o cube

# 24 vertices: 4 per face × 6 faces.
# +X face
v  0.5 -0.5  0.5
v  0.5 -0.5 -0.5
v  0.5  0.5 -0.5
v  0.5  0.5  0.5
# -X face
v -0.5 -0.5 -0.5
v -0.5 -0.5  0.5
v -0.5  0.5  0.5
v -0.5  0.5 -0.5
# +Y face (top, world is Y-up)
v -0.5  0.5  0.5
v  0.5  0.5  0.5
v  0.5  0.5 -0.5
v -0.5  0.5 -0.5
# -Y face (bottom)
v -0.5 -0.5 -0.5
v  0.5 -0.5 -0.5
v  0.5 -0.5  0.5
v -0.5 -0.5  0.5
# +Z face (front)
v -0.5 -0.5  0.5
v  0.5 -0.5  0.5
v  0.5  0.5  0.5
v -0.5  0.5  0.5
# -Z face (back)
v  0.5 -0.5 -0.5
v -0.5 -0.5 -0.5
v -0.5  0.5 -0.5
v  0.5  0.5 -0.5

vn  1.0  0.0  0.0
vn -1.0  0.0  0.0
vn  0.0  1.0  0.0
vn  0.0 -1.0  0.0
vn  0.0  0.0  1.0
vn  0.0  0.0 -1.0

vt 0.0 0.0
vt 1.0 0.0
vt 1.0 1.0
vt 0.0 1.0

# Faces (v/vt/vn). tobj triangulates each quad into two triangles preserving
# winding.
f  1/1/1  2/2/1  3/3/1  4/4/1
f  5/1/2  6/2/2  7/3/2  8/4/2
f  9/1/3 10/2/3 11/3/3 12/4/3
f 13/1/4 14/2/4 15/3/4 16/4/4
f 17/1/5 18/2/5 19/3/5 20/4/5
f 21/1/6 22/2/6 23/3/6 24/4/6
